# DB_URL=jdbc:postgresql://127.0.0.1:5433/knowledgebase
# DB_USER=knowledgebase
# KEYCLOAK_ISSUER=http://127.0.0.1:5173/auth/realms/knowledge-base
# KEYCLOAK_CLIENT_ID=knowledge-base-web
